# ==========================================================
# FaceAttend Pro Backend Configuration
# Instructions: Copy this file to .env inside backend/ (e.g. cp .env.copy .env)
# ==========================================================
NODE_ENV=development
PORT=5001
API_PREFIX=/api

# MongoDB (local MongoDB or MongoDB Atlas URI)
DATABASE_URL=mongodb://127.0.0.1:27017/smart_attendance

# JWT Authentication Secrets
JWT_ACCESS_SECRET=replace_with_a_long_random_string_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# Allowed Frontend Origins (Vite dev server default: 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Upload settings (Supports high-res student photos)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# Timezone
APP_TIMEZONE=Asia/Kolkata

# ---------- Python Face Recognition Service ----------
ML_SERVICE_URL=http://127.0.0.1:5002
# MUST match ML_SHARED_SECRET in the root .env
ML_SHARED_SECRET=change_me_to_a_long_random_string
# Set true if backend should automatically launch the Python ML service
ML_AUTOSTART=true
# Windows path example: ..\.venv\Scripts\python.exe | Linux/Mac: ../.venv/bin/python
PYTHON_BIN=
ML_TIMEOUT_MS=20000
INTERNAL_BASE_URL=http://127.0.0.1:5001/api

# AMB82 / Hardware device timings
DEVICE_MIN_FRAME_INTERVAL_MS=400
ACTIVE_LIVENESS_MIN_MOTION=0.04

# Seed default accounts (created by: npm run seed)
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=123456789
SEED_TEACHER_EMAIL=teacher@example.com
SEED_TEACHER_PASSWORD=123456789

LOG_LEVEL=info
