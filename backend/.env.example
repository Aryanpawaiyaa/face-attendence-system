# ==========================================================
# FaceAttend Pro backend - copy to backend/.env
# ==========================================================
NODE_ENV=development
PORT=5001
API_PREFIX=/api

# MongoDB (local install or MongoDB Atlas connection string)
DATABASE_URL=mongodb://127.0.0.1:27017/smart_attendance

# JWT - use long random strings (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# Frontend origins allowed by CORS (Vite dev server = 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# Institution timezone - used for "today", late cut-off and reports
APP_TIMEZONE=Asia/Kolkata

# ---------- Python face-recognition service ----------
ML_SERVICE_URL=http://127.0.0.1:5002
# MUST equal ML_SHARED_SECRET in the project-root .env (Python)
ML_SHARED_SECRET=change_me_to_a_long_random_string
# Backend spawns the Python service automatically when true
ML_AUTOSTART=true
# Windows venv example: ..\\.venv\\Scripts\\python.exe   macOS/Linux: ../.venv/bin/python
PYTHON_BIN=
ML_TIMEOUT_MS=20000
# URL the ML service uses to post camera events back to this backend
INTERNAL_BASE_URL=http://127.0.0.1:5001/api

# Min milliseconds between frames from one AMB82 (429 if faster)
DEVICE_MIN_FRAME_INTERVAL_MS=400
# Head-yaw change needed by the movement liveness check
ACTIVE_LIVENESS_MIN_MOTION=0.04

# Seed accounts (npm run seed)
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=123456789
SEED_TEACHER_EMAIL=teacher@example.com
SEED_TEACHER_PASSWORD=123456789

LOG_LEVEL=info
