# ==========================================================
# FaceAttend Pro - Python ML service configuration
# Copy to .env (same folder as this file)
# ==========================================================

# --- ML service (internal, called only by the Node backend) ---
ML_HOST=127.0.0.1
ML_PORT=5002
# MUST equal ML_SHARED_SECRET in backend/.env
ML_SHARED_SECRET=change_me_to_a_long_random_string

# --- Model: buffalo_l (recommended) | antelopev2 (ResNet100, heavier) | buffalo_s (low-end PCs)
FACE_MODEL=buffalo_l
DET_SIZE=640
DET_THRESH=0.5
USE_GPU=true

# --- Matching ---
RECOGNITION_THRESHOLD=0.45
RECOGNITION_MARGIN=0.05
RECOGNITION_CONSISTENCY_FRAMES=3
ATTENDANCE_COOLDOWN_SECONDS=30
MIN_FACE_SIZE=60

# --- Quality gates (enrolment + recognition) ---
QUALITY_MIN_DET_SCORE=0.6
QUALITY_MIN_BLUR=35
QUALITY_MAX_YAW=0.28
ENROLL_MIN_SAMPLES=3
ENROLL_MAX_SAMPLES=30

# --- Optional anti-spoofing model (MiniFASNetV2 80x80 ONNX), e.g. models/minifasnet_v2.onnx
# Without it, "Require liveness" in Settings uses the head-movement check instead.
ANTISPOOF_MODEL=
ANTISPOOF_THRESHOLD=0.6

# --- Performance: max parallel model runs (CPU: 2, GPU: 4)
ML_MAX_CONCURRENCY=2

# --- Adaptive templates: add one unambiguous live sample per student per day
ADAPTIVE_TEMPLATES=true
ADAPT_MIN_SCORE=0.60
ADAPT_MIN_MARGIN=0.20
ADAPT_INTERVAL_HOURS=24
ADAPTIVE_MAX_SAMPLES=5

# --- Camera streams (AMB82 RTSP / MJPEG) ---
STREAM_PROCESS_INTERVAL=0.35
STREAM_UNKNOWN_COOLDOWN=20

# --- Desktop recogniser (run_attendance.py) acting as a device ---
BACKEND_API_URL=http://localhost:5001/api
DEVICE_CODE=WEBCAM-DEV-01
DEVICE_API_KEY=
CAMERA_INDEX=0
COURSE_ID=
